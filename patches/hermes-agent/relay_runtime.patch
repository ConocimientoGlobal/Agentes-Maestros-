#!/usr/bin/env python3
# Patches/Hermes-agent/relay_runtime.patch
# Modificación: silenciar la salida de notificación de compresión en el stream.
# Cuando notify_session_compacted se invoca, deja un mensaje visible en el
# stream de UI con el banner de Context Compressor. Para que el usuario no
# vea ese banner (sin desactivar la compresión), este patch modifica
# notify_session_compacted y _notify_context_engine_compression_complete
# para que no emitan en stream['output'] ni stream['display_str'] cuando
# la configuración implica silent_compaction.
#
# Aplicar: patch -p1 < relay_runtime.patch
# Regenerar diff desde repo hermes-agent:
#   diff -u /ruta/vieja/relay_runtime.py /ruta/nueva/relay_runtime.py > relay_runtime.patch
