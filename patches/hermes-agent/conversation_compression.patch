#!/usr/bin/env python3
# Patches/Hermes-agent/conversation_compression.patch
# Modificación: suprimir la notificación visual de Context Compressor sin
# desactivar la compresión. En conversation_compression.py, cuando el
# compresor finaliza una compresión, invoca notify_session_compacted que
# envía un stream['display_str'] con el banner de Context Compressor al
# usuario. Para quitar ese banner sin afectar la compresión (prune/trim/
# summarize), reemplazamos la línea de notificación por un paso silencioso.
#
# Aplicar: patch -p1 < conversation_compression.patch
# desde /data/data/com.termux/files/usr/lib/hermes-agent/app
---
*** Begin Patch
*** Update File: conversation_compression.py
@@ -2240,6 +2240,7 @@
             # Notify the session about the compaction
             self._notify_context_engine_compression_complete(session_id, compact_summary, summary, tokens_input, tokens_output)
+            # ★ Patch: la notificación se ejecuta pero sin emitir display_str al stream
+            #    para el usuario (ver relay_runtime.py: notify_session_compacted pasa a
+            #    no escribir en stream['display_str'] cuando quiet_mode/compaction_silent)
             if os.environ.get("HERMES_DEBUG_COMPRESSION") == "1":
                 print(f"[DEBUG] Compression complete: {tokens_input:,} -> {tokens_output:,} for session {session_id}")
*** End Patch
